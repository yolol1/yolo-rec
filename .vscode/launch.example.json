// VS Code 调试配置模板
// 使用方法：复制此文件为 launch.json（即去掉 .example 后缀）
// 你可以在 launch.json 中自由添加或修改配置，不会影响仓库
//
// ⚠️ 调试器要求：Go 1.25+ 默认生成 DWARFv5 调试符号，需要更新 Delve：
//    go install github.com/go-delve/delve/cmd/dlv@latest
//    如果调试时报错 "DWARFv5 or later"，请运行上述命令更新 Delve。
{
  "version": "0.1.0",
  "configurations": [
    // ========== 主程序调试配置 ==========
    // 调试主程序（推荐：使用增量编译，只在源码变化时重新编译）
    {
      "name": "🚀 Debug Main Program",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/bin/bililive-dev",
      "windows": {
        "program": "${workspaceFolder}/bin/bililive-dev.exe"
      },
      "args": [
        "-c",
        "${workspaceFolder}/config.yml"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev-incremental"
    },
    // 直接从源码调试（无需预编译，使用 VS Code 自动编译）
    {
      "name": "Debug Main Program (Source)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/src/cmd/bililive",
      "args": [
        "-c",
        "${workspaceFolder}/config.yml"
      ],
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=dev"
    },
    // 附加到正在运行的进程
    {
      "name": "Attach to Process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    }
  ]
}
